# Datenquelle: "file" (lokale JSON-Dateien, für Entwicklung/Tests) oder "neon" (Produktion)
DATA_SOURCE=file
# Nur bei DATA_SOURCE=file: Ordner mit den JSON-Dateien (wird beim ersten Start aus fixtures/dev kopiert)
DATA_DIR=.data/dev

# Nur bei DATA_SOURCE=neon. Bleibt auf dem Server, landet nie im Browser.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Zufälliger langer String zum Signieren der Login-Cookies (z. B. `openssl rand -hex 32`)
SESSION_SECRET=change-me

# PIN-Hashes je Spieler als JSON. Hash erzeugen: `npm run pin -- 1234`
# Ohne diese Variable gilt im file-Modus für alle die PIN 0000; im neon-Modus ist Login dann gesperrt.
PLAYER_PINS={"thomas":"scrypt$...","julia":"scrypt$...","viktor":"scrypt$..."}

# Wer Ergebnisse eintragen darf (Komma-getrennt)
ADMIN_PLAYERS=viktor

# Optional: feste "Jetzt"-Zeit für Tests/Vorschau (ISO), z. B. 2026-11-07T12:00:00Z
# NOW_OVERRIDE=
